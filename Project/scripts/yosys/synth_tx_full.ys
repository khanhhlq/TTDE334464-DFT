read_verilog rtl/common/scan_dff.v
read_verilog rtl/full_scan/uart_tx_scan.v

chparam -set CLKS_PER_BIT 16 uart_tx_scan
hierarchy -check -top uart_tx_scan

synth -top uart_tx_scan -flatten -nofsm -noabc
dffunmap
abc -g AND,OR,XOR,XNOR
clean
check -assert
stat

write_verilog -noattr build/tx_full/netlist.v
write_json build/tx_full/netlist.json